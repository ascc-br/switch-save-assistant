<Window x:Class="SwitchSaveAssistant.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings_Title}"
        Width="690"
        Height="590"
        MinWidth="620"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="18"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16">

            <StackPanel>

                <TextBlock
                    Text="{DynamicResource Settings_Header}"
                    FontSize="24"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Margin="0,6,0,0"
                    Text="{DynamicResource Settings_Description}"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            </StackPanel>

        </Border>

        <Border
            Grid.Row="2"
            Padding="18"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Text="{DynamicResource Settings_Language}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <ComboBox
                    Grid.Row="0"
                    Grid.Column="1"
                    x:Name="LanguageComboBox"
                    Height="36">

                    <ComboBoxItem
                        Tag="en-US"
                        Content="{DynamicResource Settings_LanguageEnglish}"/>

                    <ComboBoxItem
                        Tag="es-ES"
                        Content="{DynamicResource Settings_LanguageSpanish}"/>

                    <ComboBoxItem
                        Tag="pt-BR"
                        Content="{DynamicResource Settings_LanguagePortuguese}"/>

                </ComboBox>

                <TextBlock
                    Grid.Row="2"
                    Text="{DynamicResource Settings_Theme}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <ComboBox
                    Grid.Row="2"
                    Grid.Column="1"
                    x:Name="ThemeComboBox"
                    Height="36">

                    <ComboBoxItem
                        Tag="System"
                        Content="{DynamicResource Settings_ThemeSystem}"/>

                    <ComboBoxItem
                        Tag="Light"
                        Content="{DynamicResource Settings_ThemeLight}"/>

                    <ComboBoxItem
                        Tag="Dark"
                        Content="{DynamicResource Settings_ThemeDark}"/>

                </ComboBox>

                <TextBlock
                    Grid.Row="4"
                    Text="{DynamicResource Settings_Folder}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <Grid
                    Grid.Row="4"
                    Grid.Column="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="FolderPathTextBox"
                        Height="36"
                        IsReadOnly="True"
                        VerticalContentAlignment="Center"/>

                    <Button
                        Grid.Column="2"
                        Width="140"
                        Height="36"
                        Content="{DynamicResource Settings_SelectFolder}"
                        Click="SelectFolder_Click"/>

                </Grid>

                <TextBlock
                    Grid.Row="6"
                    Text="{DynamicResource Settings_DefaultEmulator}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <ComboBox
                    Grid.Row="6"
                    Grid.Column="1"
                    x:Name="DefaultEmulatorComboBox"
                    Height="36">

                    <ComboBoxItem
                        Tag="Automatic"
                        Content="{DynamicResource Settings_EmulatorAutomatic}"/>

                    <ComboBoxItem
                        Tag="Eden"
                        Content="{DynamicResource Settings_EmulatorEden}"/>

                    <ComboBoxItem
                        Tag="Citron"
                        Content="{DynamicResource Settings_EmulatorCitron}"/>

                    <ComboBoxItem
                        Tag="Ryujinx"
                        Content="{DynamicResource Settings_EmulatorRyujinx}"/>

                </ComboBox>

            </Grid>

        </Border>

        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Width="110"
                Height="38"
                Content="{DynamicResource Settings_Cancel}"
                IsCancel="True"/>

            <Button
                Width="120"
                Height="38"
                Margin="10,0,0,0"
                Content="{DynamicResource Settings_Save}"
                IsDefault="True"
                Click="Save_Click"/>

        </StackPanel>

    </Grid>

</Window>
