<Window x:Class="SwitchSaveAssistant.App.ProfileAliasRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AliasRepair_Title}"
        Width="880"
        Height="650"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="14">
            <StackPanel>
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="{DynamicResource AliasRepair_Title}"/>
                <TextBlock
                    x:Name="ContextText"
                    Margin="0,5,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            Padding="14"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="SummaryText"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{DynamicResource AliasRepair_KeepVersion}"/>

                    <ComboBox
                        Grid.Column="2"
                        x:Name="SourceAliasCombo"
                        Height="34"
                        VerticalContentAlignment="Center"
                        SelectionChanged="SourceAliasCombo_SelectionChanged"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="56*"/>
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{DynamicResource AliasRepair_Copies}"/>

                    <DataGrid
                        Grid.Row="2"
                        x:Name="CandidatesGrid"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="{DynamicResource Profiles_ColumnName}"
                                Binding="{Binding Alias}"
                                Width="*"/>
                            <DataGridTextColumn
                                Header="{DynamicResource AliasRepair_Files}"
                                Binding="{Binding Files}"
                                Width="70"/>
                            <DataGridTextColumn
                                Header="{DynamicResource AliasRepair_Size}"
                                Binding="{Binding Size}"
                                Width="90"/>
                            <DataGridTextColumn
                                Header="{DynamicResource AliasRepair_LastWrite}"
                                Binding="{Binding LastWrite}"
                                Width="145"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="DifferencesHeaderText"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{DynamicResource AliasRepair_Differences}"/>

                    <DataGrid
                        Grid.Row="2"
                        x:Name="DifferencesGrid"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="{DynamicResource AliasRepair_Compared}"
                                Binding="{Binding Pair}"
                                Width="145"/>
                            <DataGridTextColumn
                                Header="{DynamicResource AliasRepair_Change}"
                                Binding="{Binding Kind}"
                                Width="105"/>
                            <DataGridTextColumn
                                Header="{DynamicResource AliasRepair_Path}"
                                Binding="{Binding Path}"
                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="ProgressText"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal">
                <Button
                    x:Name="CancelButton"
                    Width="100"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="{DynamicResource AliasRepair_Cancel}"
                    Click="Cancel_Click"/>
                <Button
                    x:Name="RepairButton"
                    Width="150"
                    Height="36"
                    IsEnabled="False"
                    Content="{DynamicResource AliasRepair_Repair}"
                    Click="Repair_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

