<Window x:Class="SwitchSaveAssistant.App.FolderSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder ⇄ Switch"
        Width="1100"
        Height="760"
        MinWidth="880"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho compacto -->
        <Border
            Grid.Row="0"
            Padding="18"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="18">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border
                    Width="58"
                    Height="58"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                    CornerRadius="16"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="🔄"
                        FontSize="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Folder ⇄ Switch"
                        FontSize="28"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="{DynamicResource Switch_Description}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Origem / Switch -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="18"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16">

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="42"
                            Height="42"
                            Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="12">

                            <TextBlock
                                Text="📁"
                                FontSize="21"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="12,0,0,0">
                            <TextBlock
                                Text="{DynamicResource Common_Folder}"
                                FontSize="18"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Switch_CentralSaveFolder}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBox
                        x:Name="FolderPathTextBox"
                        Height="38"
                        Margin="0,16,0,0"
                        Padding="10,6"
                        IsReadOnly="True"
                        VerticalContentAlignment="Center"
                        Text="{DynamicResource Switch_NoFolderSelected}"/>

                    <Button
                        Width="170"
                        Height="38"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        Content="{DynamicResource Switch_SelectFolder}"
                        Click="SelectFolder_Click"/>
                </StackPanel>
            </Border>

            <Border
                Grid.Column="2"
                Padding="18"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="42"
                            Height="42"
                            Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="12">

                            <TextBlock
                                Text="🎮"
                                FontSize="21"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="12,0,0,0">
                            <TextBlock
                                Text="Nintendo Switch / DBI"
                                FontSize="18"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Switch_DetectionReadOnly}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Grid.Row="1"
                        Margin="0,16,0,0"
                        Padding="12,9"
                        Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                        CornerRadius="10">

                        <TextBlock
                            x:Name="SwitchStatusText"
                            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                            FontWeight="SemiBold"
                            Text="{DynamicResource Switch_NotChecked}"/>
                    </Border>

                    <StackPanel
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        Orientation="Horizontal">

                        <Button
                            x:Name="SwitchActionButton"
                            Width="170"
                            Height="38"
                            Content="{DynamicResource Switch_Detect}"
                            Click="DetectSwitch_Click"/>

                        <Button
                            Width="190"
                            Height="38"
                            Margin="10,0,0,0"
                            Content="{DynamicResource Switch_Help}"
                            Click="OpenSwitchHelp_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Catálogo -->
        <Border
            Grid.Row="4"
            Padding="16"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Título, resumo e filtro -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="{DynamicResource Switch_GamesAndProfiles}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Grid.Column="1"
                        x:Name="CatalogSummaryText"
                        Margin="20,0,16,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center"
                        Text=""/>

                    <TextBlock
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center"
                        Text="{DynamicResource Common_Filter}"/>

                    <ComboBox
                        Grid.Column="3"
                        x:Name="CatalogFilterComboBox"
                        Width="185"
                        Height="34"
                        SelectedIndex="0"
                        SelectionChanged="CatalogFilter_SelectionChanged">

                        <ComboBoxItem Content="{DynamicResource Common_All}" Tag="All"/>
                        <ComboBoxItem Content="{DynamicResource Switch_OnlyFolder}" Tag="FolderOnly"/>
                        <ComboBoxItem Content="{DynamicResource Switch_OnlySwitch}" Tag="SwitchOnly"/>
                        <ComboBoxItem Content="{DynamicResource Common_Synchronized}" Tag="Synchronized"/>
                        <ComboBoxItem Content="{DynamicResource Common_Divergent}" Tag="Divergent"/>
                        <ComboBoxItem Content="{DynamicResource Common_WithErrors}" Tag="Error"/>
                    </ComboBox>
                </Grid>

                <!-- Progresso da comparação -->
                <Grid
                    Grid.Row="1"
                    x:Name="ComparisonProgressPanel"
                    Margin="0,12,0,0"
                    Visibility="Collapsed">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ProgressBar
                        x:Name="ComparisonProgressBar"
                        Height="6"
                        Minimum="0"
                        Maximum="1"
                        Value="0"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Grid.Column="1"
                        x:Name="ComparisonProgressText"
                        Margin="14,0,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center"
                        Text="{DynamicResource Common_Comparing}"/>
                </Grid>

                <!-- Lista -->
                <ScrollViewer
                    Grid.Row="3"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel x:Name="GamesPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</Window>


















