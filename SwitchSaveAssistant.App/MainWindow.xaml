<Window Icon="pack://application:,,,/Assets/App.ico" x:Class="SwitchSaveAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App_Name}"
        Width="960"
        Height="620"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="22"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="18">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock
                            Text="{DynamicResource App_Name}"
                            FontSize="30"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="15"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Main_Subtitle}"/>

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <Button
                            Width="175"
                            Height="38"
                            Margin="0,0,12,0"
                            Content="{DynamicResource Profiles_OpenManager}"
                            Click="OpenProfiles_Click"/>
                        <Button
                            Width="150"
                            Height="38"
                            Margin="0,0,12,0"
                            Content="{DynamicResource Main_Settings}"
                            Click="OpenSettings_Click"/>

                        <Border
                            Width="72"
                            Height="72"
                            Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="18">

                            <TextBlock
                                Text="🎮"
                                FontSize="34"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </StackPanel>

                </Grid>

            </Border>

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    MinHeight="260"
                    Padding="22"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="18">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Orientation="Horizontal">

                            <Border
                                Width="52"
                                Height="52"
                                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                CornerRadius="14">

                                <TextBlock
                                    Text="📁"
                                    FontSize="26"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock
                                Margin="14,0,0,0"
                                Text="{DynamicResource Main_FolderSwitchTitle}"
                                FontSize="23"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,18,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Main_FolderSwitchDescription}"/>

                        <Button
                            Grid.Row="3"
                            Width="150"
                            Height="38"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Left"
                            Content="{DynamicResource Main_OpenModule}"
                            Click="OpenFolderSwitch_Click"/>

                    </Grid>

                </Border>

                <Border
                    Grid.Column="2"
                    MinHeight="260"
                    Padding="22"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="18">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Orientation="Horizontal">

                            <Border
                                Width="52"
                                Height="52"
                                Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                CornerRadius="14">

                                <TextBlock
                                    Text="🕹️"
                                    FontSize="26"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock
                                Margin="14,0,0,0"
                                Text="{DynamicResource Main_EmulatorFolderTitle}"
                                FontSize="23"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,18,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Main_EmulatorFolderDescription}"/>

                        <Button
                            Grid.Row="3"
                            Width="150"
                            Height="38"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Left"
                            Content="{DynamicResource Main_OpenModule}"
                            Click="OpenEmulatorFolder_Click"/>

                    </Grid>

                </Border>

            </Grid>

            <Border
                Grid.Row="4"
                Padding="14,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14">

                <StackPanel Orientation="Horizontal">

                    <Ellipse
                        Width="9"
                        Height="9"
                        Fill="{DynamicResource SystemFillColorNeutralBrush}"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Main_SwitchUnchecked}"/>

                </StackPanel>

            </Border>

            <Border x:Name="UpdateBanner" Grid.Row="5" Visibility="Collapsed" Margin="0,12,0,0" Padding="14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Updates_OpenSettings}" Padding="12,6" Margin="12,0,0,0" Click="OpenSettings_Click"/>
                    <TextBlock x:Name="UpdateBannerText" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
            </Border>
        </Grid>

    </ScrollViewer>

</Window>

